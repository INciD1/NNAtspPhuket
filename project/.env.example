# Copy this file to .env and fill in your own Google Maps API key.
# Needs the Geocoding API, Maps JavaScript API, and Directions API enabled
# in Google Cloud Console.
GOOGLE_MAPS_API_KEY=your_key_here

# Optional: set to "true" to enable Flask debug mode locally.
# Leave unset (or "false") for anything resembling production.
FLASK_DEBUG=false
